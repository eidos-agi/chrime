{"id": 1, "complexity": 1, "english": "Ping the API and confirm it answers that everything is ok.", "ops": [{"op": "ping"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 2, "complexity": 1, "english": "Ask for help and confirm the response lists available operations.", "ops": [{"op": "help"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "ops", "type": "list"}, {"on": -1, "path": "ops", "contains": "navigate"}], "tags": []}
{"id": 3, "complexity": 1, "english": "Ask for ops (alias of help) and confirm navigate is listed.", "ops": [{"op": "ops"}], "assert": [{"on": -1, "path": "ops", "contains": "snapshot"}], "tags": []}
{"id": 4, "complexity": 1, "english": "Send empty JSON object without an op and expect a clear error.", "ops": [{}], "assert": [{"on": -1, "path": "ok", "eq": false}, {"on": -1, "path": "code", "exists": true}], "tags": []}
{"id": 5, "complexity": 1, "english": "Send an unknown operation name and expect unknown_op or similar failure.", "ops": [{"op": "definitely_not_a_real_op"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 6, "complexity": 1, "english": "Send invalid JSON (as a bare string op) and expect a bad_json style failure.", "ops": [{"op": "ping"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": ["sanity"]}
{"id": 7, "complexity": 1, "english": "Call hello (alias of ping) and expect ok true.", "ops": [{"op": "hello"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 8, "complexity": 1, "english": "Call status on a fresh session with no page and expect ok without crashing.", "ops": [{"op": "status"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 9, "complexity": 1, "english": "Call current with no page and expect a url field that is null or missing.", "ops": [{"op": "current"}], "assert": [{"on": -1, "path": "url", "exists": true}], "tags": []}
{"id": 10, "complexity": 1, "english": "Confirm help promises that secrets are never returned.", "ops": [{"op": "help"}], "assert": [{"on": -1, "path": "secret_output", "eq": "suppressed"}], "tags": []}
{"id": 11, "complexity": 2, "english": "Go to example.com using a full https URL and confirm navigation succeeds.", "ops": [{"op": "navigate", "url": "https://example.com"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "url", "contains": "example.com"}], "tags": []}
{"id": 12, "complexity": 2, "english": "Go to example.com using a bare host name and confirm it resolves to https.", "ops": [{"op": "navigate", "url": "example.com"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "url", "contains": "example.com"}], "tags": []}
{"id": 13, "complexity": 2, "english": "Navigate to example.com and confirm the page title mentions Example.", "ops": [{"op": "navigate", "url": "https://example.com"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "title", "contains": "Example"}], "tags": []}
{"id": 14, "complexity": 2, "english": "Navigate to example.com and check HTTP status is 200.", "ops": [{"op": "navigate", "url": "https://example.com"}], "assert": [{"on": -1, "path": "status", "eq": 200}], "tags": []}
{"id": 15, "complexity": 2, "english": "Navigate to an empty URL string and expect failure without crashing.", "ops": [{"op": "navigate", "url": ""}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 16, "complexity": 2, "english": "After navigating to example.com, ask for current URL and see example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "current"}], "assert": [{"on": -1, "path": "url", "contains": "example.com"}], "tags": []}
{"id": 17, "complexity": 2, "english": "After navigating, status should report a positive node_count.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "status"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "node_count", "gte": 1}], "tags": []}
{"id": 18, "complexity": 2, "english": "Navigate to example.com twice in a row and both should succeed.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "navigate", "url": "https://example.com"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 1, "path": "ok", "eq": true}], "tags": []}
{"id": 19, "complexity": 2, "english": "Navigate with a trailing slash URL and still land on example.com.", "ops": [{"op": "navigate", "url": "https://example.com/"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 20, "complexity": 2, "english": "Navigate to httpbin status 404 if reachable, or accept network failure without hang.", "ops": [{"op": "navigate", "url": "https://httpbin.org/status/404"}], "assert": [{"on": -1, "path": "ok", "exists": true}], "tags": ["network", "optional"]}
{"id": 21, "complexity": 3, "english": "Navigate to example.com and take a full snapshot; it must list nodes.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "nodes", "type": "list"}, {"on": -1, "path": "node_count", "gte": 1}, {"on": -1, "path": "view", "eq": "full"}], "tags": []}
{"id": 22, "complexity": 3, "english": "Snapshot nodes must each have a node_id.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "nodes.0.node_id", "type": "number"}], "tags": []}
{"id": 23, "complexity": 3, "english": "Snapshot should include a title for example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "title", "contains": "Example"}], "tags": []}
{"id": 24, "complexity": 3, "english": "Read the full page text and confirm it mentions Example Domain.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "read"}], "assert": [{"on": -1, "path": "text", "contains": "Example"}], "tags": []}
{"id": 25, "complexity": 3, "english": "Read text should be a non-empty string after loading example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "read"}], "assert": [{"on": -1, "path": "text", "type": "string"}, {"on": -1, "path": "text", "min_len": 5}], "tags": []}
{"id": 26, "complexity": 3, "english": "Snapshot must report html_bytes greater than zero for a real page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "html_bytes", "gte": 100}], "tags": []}
{"id": 27, "complexity": 3, "english": "Every snapshot node must have a role string.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "nodes.0.role", "type": "string"}], "tags": []}
{"id": 28, "complexity": 3, "english": "Snapshot url should match the navigated example.com host.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}], "assert": [{"on": -1, "path": "url", "contains": "example.com"}], "tags": []}
{"id": 29, "complexity": 3, "english": "Calling snapshot without navigate should still return a structure with nodes list.", "ops": [{"op": "snapshot"}], "assert": [{"on": -1, "path": "nodes", "type": "list"}], "tags": []}
{"id": 30, "complexity": 3, "english": "Status after navigate should echo the title when available.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "status"}], "assert": [{"on": -1, "path": "title", "contains": "Example"}], "tags": []}
{"id": 31, "complexity": 4, "english": "List available views and confirm outline and meta are present.", "ops": [{"op": "views"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "views", "type": "list"}], "tags": []}
{"id": 32, "complexity": 4, "english": "Views response should mention one HTML buffer memory model.", "ops": [{"op": "views"}], "assert": [{"on": -1, "path": "memory", "contains": "buffer"}], "tags": []}
{"id": 33, "complexity": 4, "english": "Open example.com and request the full view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "full"}], "assert": [{"on": -1, "path": "view", "eq": "full"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 34, "complexity": 4, "english": "Open example.com and request the outline view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "outline"}], "assert": [{"on": -1, "path": "view", "eq": "outline"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 35, "complexity": 4, "english": "Open example.com and request the links view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "links"}], "assert": [{"on": -1, "path": "view", "eq": "links"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 36, "complexity": 4, "english": "Open example.com and request the fields view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "fields"}], "assert": [{"on": -1, "path": "view", "eq": "fields"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 37, "complexity": 4, "english": "Open example.com and request the clickables view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "clickables"}], "assert": [{"on": -1, "path": "view", "eq": "clickables"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 38, "complexity": 4, "english": "Open example.com and request the text view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "text"}], "assert": [{"on": -1, "path": "view", "eq": "text"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 39, "complexity": 4, "english": "Open example.com and request the compact view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "compact"}], "assert": [{"on": -1, "path": "view", "eq": "compact"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 40, "complexity": 4, "english": "Open example.com and request the meta view of the same page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "meta"}], "assert": [{"on": -1, "path": "view", "eq": "meta"}, {"on": -1, "path": "html_bytes", "gte": 1}], "tags": []}
{"id": 41, "complexity": 5, "english": "Outline view should only include heading nodes (or be empty of non-headings).", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "outline"}], "assert": [{"on": -1, "path": "view", "eq": "outline"}, {"on": -1, "path": "nodes", "all_role_in": ["heading"]}], "tags": []}
{"id": 42, "complexity": 5, "english": "Links view should only include link roles with clickable links.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "links"}], "assert": [{"on": -1, "path": "nodes", "all_role_in": ["link"]}], "tags": []}
{"id": 43, "complexity": 5, "english": "Meta view must return zero nodes but still report counts.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "meta"}], "assert": [{"on": -1, "path": "node_count", "eq": 0}, {"on": -1, "path": "nodes", "len_eq": 0}, {"on": -1, "path": "counts", "type": "object"}], "tags": []}
{"id": 44, "complexity": 5, "english": "Compact view must not return more nodes than the full snapshot.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}, {"op": "view", "kind": "compact"}], "assert": [{"on": -1, "path": "view", "eq": "compact"}, {"on": 1, "path": "node_count", "gte_path": {"on": 2, "path": "node_count"}}], "tags": []}
{"id": 45, "complexity": 5, "english": "Snapshot with view=outline parameter should behave like view op.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot", "view": "outline"}], "assert": [{"on": -1, "path": "view", "eq": "outline"}], "tags": []}
{"id": 46, "complexity": 5, "english": "Unknown view kind should produce a clear error.", "ops": [{"op": "view", "kind": "not_a_real_view"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 47, "complexity": 5, "english": "Clickables view on example.com should include the Learn more link.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "clickables"}], "assert": [{"on": -1, "path": "nodes", "any_text_contains": "Learn"}], "tags": []}
{"id": 48, "complexity": 5, "english": "Full and outline views must share the same html_bytes for one page.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "full"}, {"op": "view", "kind": "outline"}], "assert": [{"on": 1, "path": "html_bytes", "eq_path": {"on": 2, "path": "html_bytes"}}], "tags": []}
{"id": 49, "complexity": 5, "english": "Text view roles should only be text when nodes are present.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "text"}], "assert": [{"on": -1, "path": "nodes", "all_role_in": ["text"]}], "tags": []}
{"id": 50, "complexity": 5, "english": "Fields view should not crash on a page with no forms.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "fields"}], "assert": [{"on": -1, "path": "view", "eq": "fields"}], "tags": []}
{"id": 51, "complexity": 6, "english": "Find text 'Example' on example.com and expect at least one match.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "Example"}], "assert": [{"on": -1, "type": "list"}, {"on": -1, "min_len": 1}], "tags": []}
{"id": 52, "complexity": 6, "english": "Find text that is not on the page and expect an empty list.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "zzzxxyyzz_not_present"}], "assert": [{"on": -1, "type": "list"}, {"on": -1, "len_eq": 0}], "tags": []}
{"id": 53, "complexity": 6, "english": "Find text should be case-insensitive for 'example'.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "example"}], "assert": [{"on": -1, "min_len": 1}], "tags": []}
{"id": 54, "complexity": 6, "english": "List links on example.com and expect at least one with an href.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "links"}], "assert": [{"on": -1, "type": "list"}, {"on": -1, "min_len": 1}, {"on": -1, "path": "0.href", "contains": "http"}], "tags": []}
{"id": 55, "complexity": 6, "english": "Every link from links op should be marked clickable.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "links"}], "assert": [{"on": -1, "path": "0.clickable", "eq": true}], "tags": []}
{"id": 56, "complexity": 6, "english": "find_text results should include node_id fields.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "More"}], "assert": [{"on": -1, "path": "0.node_id", "type": "number"}], "tags": []}
{"id": 57, "complexity": 6, "english": "Empty find_text query should return empty or harmless result.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": ""}], "assert": [{"on": -1, "type": "list"}], "tags": []}
{"id": 58, "complexity": 6, "english": "Links list length should match clickable links in full snapshot roughly.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "links"}, {"op": "view", "kind": "links"}], "assert": [{"on": 1, "type": "list"}, {"on": 2, "path": "node_count", "gte": 1}], "tags": []}
{"id": 59, "complexity": 6, "english": "Find 'Domain' on example.com returns matches containing that word.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "Domain"}], "assert": [{"on": -1, "min_len": 1}], "tags": []}
{"id": 60, "complexity": 6, "english": "After navigate, links op must not return ok:false error object.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "links"}], "assert": [{"on": -1, "type": "list"}], "tags": []}
{"id": 61, "complexity": 7, "english": "Click a non-link node and expect a clear error about no href.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "click", "node_id": 1}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 62, "complexity": 7, "english": "Click node_id 0 which does not exist and expect failure.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "click", "node_id": 0}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 63, "complexity": 7, "english": "Click a huge node_id that does not exist and expect failure.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "click", "node_id": 999999}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 64, "complexity": 7, "english": "Find the Learn more link, click its node_id, and leave example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "Learn more"}, {"op": "click", "node_id": "$find0"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "url", "not_contains": "example.com/"}], "tags": ["click-resolve"]}
{"id": 65, "complexity": 7, "english": "Navigate to example.com then back with only one entry should fail or no-op safely.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "back"}], "assert": [{"on": -1, "path": "ok", "exists": true}], "tags": []}
{"id": 66, "complexity": 7, "english": "Navigate example.com then iana via click, then back should return toward example.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "Learn more"}, {"op": "click", "node_id": "$find0"}, {"op": "back"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "url", "contains": "example.com"}], "tags": ["click-resolve", "network"]}
{"id": 67, "complexity": 7, "english": "After a successful click navigation, current url should change.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "find_text", "text": "Learn more"}, {"op": "click", "node_id": "$find0"}, {"op": "current"}], "assert": [{"on": -1, "path": "url", "type": "string"}, {"on": -1, "path": "url", "min_len": 8}], "tags": ["click-resolve"]}
{"id": 68, "complexity": 7, "english": "Click without prior navigate fails gracefully.", "ops": [{"op": "click", "node_id": 1}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 69, "complexity": 7, "english": "History length in status should increase after two navigations.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "navigate", "url": "https://example.org"}, {"op": "status"}], "assert": [{"on": -1, "path": "history_len", "gte": 2}], "tags": ["network"]}
{"id": 70, "complexity": 7, "english": "Back from two-page history (distinct hosts) should succeed.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "navigate", "url": "https://example.org"}, {"op": "back"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "url", "contains": "example.com"}], "tags": ["network"]}
{"id": 71, "complexity": 8, "english": "Agent script: go to example.com, take outline view, confirm a heading exists.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "outline"}, {"op": "status"}], "assert": [{"on": 1, "path": "node_count", "gte": 1}, {"on": 2, "path": "ok", "eq": true}], "tags": []}
{"id": 72, "complexity": 8, "english": "Agent script: snapshot, then find_text using a word from the title.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}, {"op": "find_text", "text": "Domain"}], "assert": [{"on": 2, "min_len": 1}], "tags": []}
{"id": 73, "complexity": 8, "english": "Agent script: list views, pick meta, confirm html_bytes present.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "views"}, {"op": "view", "kind": "meta"}], "assert": [{"on": 2, "path": "html_bytes", "gte": 100}], "tags": []}
{"id": 74, "complexity": 8, "english": "Agent script: navigate, links, click first link from links list via $link0.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "links"}, {"op": "click", "node_id": "$link0"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": ["click-resolve"]}
{"id": 75, "complexity": 8, "english": "Agent script: three-step inspect — status, snapshot compact, read.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "status"}, {"op": "snapshot", "view": "compact"}, {"op": "read"}], "assert": [{"on": 2, "path": "view", "eq": "compact"}, {"on": 3, "path": "text", "min_len": 5}], "tags": []}
{"id": 76, "complexity": 8, "english": "Agent script: set_ai_vis on without live surface still returns ok or stores flag.", "ops": [{"op": "set_ai_vis", "on": true}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "ai_vis", "eq": true}], "tags": []}
{"id": 77, "complexity": 8, "english": "Agent script: set_ai_vis off after on.", "ops": [{"op": "set_ai_vis", "on": true}, {"op": "set_ai_vis", "on": false}], "assert": [{"on": -1, "path": "ai_vis", "eq": false}], "tags": []}
{"id": 78, "complexity": 8, "english": "Agent script: toggle_ai_vis twice returns to a boolean state.", "ops": [{"op": "toggle_ai_vis"}, {"op": "toggle_ai_vis"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "ai_vis", "type": "boolean"}], "tags": []}
{"id": 79, "complexity": 8, "english": "Agent script: wait 10ms and confirm waited_ms is reported.", "ops": [{"op": "wait", "ms": 10}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "waited_ms", "gte": 0}], "tags": []}
{"id": 80, "complexity": 8, "english": "Agent script: ai_marks without live surface reports a count field.", "ops": [{"op": "ai_marks"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "count", "type": "number"}], "tags": []}
{"id": 81, "complexity": 9, "english": "fill without a live surface should fail with no_live style error.", "ops": [{"op": "fill", "which": "login", "text": "user@example.com"}], "assert": [{"on": -1, "path": "ok", "eq": false}, {"on": -1, "path": "code", "eq": "no_live"}], "tags": []}
{"id": 82, "complexity": 9, "english": "type without live surface should fail the same way as fill.", "ops": [{"op": "type", "which": "password", "text": "not-a-real-secret"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 83, "complexity": 9, "english": "press without live surface should fail clearly.", "ops": [{"op": "press", "key": "Enter"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 84, "complexity": 9, "english": "eval without live surface should fail clearly.", "ops": [{"op": "eval", "js": "1+1"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 85, "complexity": 9, "english": "knox_fill without live surface must not leak a password and must fail soft.", "ops": [{"op": "knox_fill", "query": "example.com", "fields": "password"}], "assert": [{"on": -1, "path": "ok", "eq": false}, {"on": -1, "path": "secret_output", "eq": "suppressed"}], "tags": []}
{"id": 86, "complexity": 9, "english": "knox_find for a nonsense query should not crash and must suppress secrets.", "ops": [{"op": "knox_find", "query": "zzzxxyyzz_knox_no_such_record_ever"}], "assert": [{"on": -1, "path": "secret_output", "eq": "suppressed"}, {"on": -1, "path": "ok", "exists": true}], "tags": ["knox"]}
{"id": 87, "complexity": 9, "english": "knox_use dry-run for nonsense query fails without printing secrets.", "ops": [{"op": "knox_use", "query": "zzzxxyyzz_knox_no_such", "field": "password", "via": "dry-run"}], "assert": [{"on": -1, "path": "secret_output", "eq": "suppressed"}], "tags": ["knox"]}
{"id": 88, "complexity": 9, "english": "set_ai_vis without on flag should error bad_args.", "ops": [{"op": "set_ai_vis"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 89, "complexity": 9, "english": "quit without force should not kill the process mid-suite (ok ignored).", "ops": [{"op": "quit"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 90, "complexity": 9, "english": "navigate to data: URL or invalid scheme fails or is rejected safely.", "ops": [{"op": "navigate", "url": "javascript:alert(1)"}], "assert": [{"on": -1, "path": "ok", "exists": true}], "tags": []}
{"id": 91, "complexity": 10, "english": "Stability: five sequential snapshots of example.com all report the same node_count.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "snapshot"}, {"op": "snapshot"}, {"op": "snapshot"}, {"op": "snapshot"}, {"op": "snapshot"}], "assert": [{"on": 1, "path": "node_count", "eq_path": {"on": 5, "path": "node_count"}}], "tags": []}
{"id": 92, "complexity": 10, "english": "Stability: outline then links then full all share html_bytes.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "outline"}, {"op": "view", "kind": "links"}, {"op": "view", "kind": "full"}], "assert": [{"on": 1, "path": "html_bytes", "eq_path": {"on": 3, "path": "html_bytes"}}], "tags": []}
{"id": 93, "complexity": 10, "english": "Complex: navigate, compact view, find_text More, ensure node_id is positive.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "compact"}, {"op": "find_text", "text": "More"}], "assert": [{"on": 2, "path": "0.node_id", "gte": 1}], "tags": []}
{"id": 94, "complexity": 10, "english": "Complex: help ops list includes knox_find and view.", "ops": [{"op": "help"}], "assert": [{"on": -1, "path": "ops", "contains": "knox_find"}, {"on": -1, "path": "ops", "contains": "view"}], "tags": []}
{"id": 95, "complexity": 10, "english": "Complex: ping then navigate then meta view then status stays ok.", "ops": [{"op": "ping"}, {"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "meta"}, {"op": "status"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 3, "path": "ok", "eq": true}], "tags": []}
{"id": 96, "complexity": 10, "english": "Complex: live field in ping is false for headless --api.", "ops": [{"op": "ping"}], "assert": [{"on": -1, "path": "live", "eq": false}], "tags": []}
{"id": 97, "complexity": 10, "english": "Complex: after navigate, status live remains false in headless.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "status"}], "assert": [{"on": -1, "path": "live", "eq": false}], "tags": []}
{"id": 98, "complexity": 10, "english": "Complex: read text length is less than raw html_bytes for example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "read"}, {"op": "snapshot"}], "assert": [{"on": 2, "path": "html_bytes", "gte": 100}], "tags": []}
{"id": 99, "complexity": 10, "english": "Complex: multi navigate to example.com and example.org keeps ok true.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "navigate", "url": "https://example.org"}, {"op": "current"}], "assert": [{"on": 1, "path": "ok", "eq": true}, {"on": 2, "path": "url", "contains": "example"}], "tags": ["network"]}
{"id": 100, "complexity": 10, "english": "Complex: wait 0 ms is allowed and returns quickly.", "ops": [{"op": "wait", "ms": 0}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": []}
{"id": 101, "complexity": 3, "english": "Navigate to example.com and confirm status ok.", "ops": [{"op": "navigate", "url": "https://example.com"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": ["network"]}
{"id": 102, "complexity": 4, "english": "On example.com, request meta view and get counts object.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "meta"}], "assert": [{"on": -1, "path": "counts", "type": "object"}], "tags": ["network"]}
{"id": 103, "complexity": 5, "english": "On example.com, compact view returns a view name compact.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "compact"}], "assert": [{"on": -1, "path": "view", "eq": "compact"}], "tags": ["network"]}
{"id": 104, "complexity": 3, "english": "Navigate to example.org and confirm status ok.", "ops": [{"op": "navigate", "url": "https://example.org"}], "assert": [{"on": -1, "path": "ok", "eq": true}], "tags": ["network"]}
{"id": 105, "complexity": 4, "english": "On example.org, request meta view and get counts object.", "ops": [{"op": "navigate", "url": "https://example.org"}, {"op": "view", "kind": "meta"}], "assert": [{"on": -1, "path": "counts", "type": "object"}], "tags": ["network"]}
{"id": 106, "complexity": 5, "english": "On example.org, compact view returns a view name compact.", "ops": [{"op": "navigate", "url": "https://example.org"}, {"op": "view", "kind": "compact"}], "assert": [{"on": -1, "path": "view", "eq": "compact"}], "tags": ["network"]}
{"id": 107, "complexity": 6, "english": "On example.com, a link node_id in links view is also present in full snapshot nodes.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "links"}, {"op": "snapshot"}], "assert": [{"on": 1, "path": "nodes.0.node_id", "type": "number"}, {"on": 2, "path": "nodes", "type": "list"}], "tags": []}
{"id": 108, "complexity": 8, "english": "Secret-safe: knox_find response must never contain key 'password' with a string value at top level.", "ops": [{"op": "knox_find", "query": "gmail"}], "assert": [{"on": -1, "path": "secret_output", "eq": "suppressed"}, {"on": -1, "forbid_keys": ["password", "secret", "value"]}], "tags": ["knox"]}
{"id": 109, "complexity": 9, "english": "fill with selector string without live still fails no_live.", "ops": [{"op": "fill", "selector": "input[type=email]", "text": "a@b.c"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": []}
{"id": 110, "complexity": 10, "english": "End-to-end agent loop: ping → navigate → outline → links → find Learn → status.", "ops": [{"op": "ping"}, {"op": "navigate", "url": "https://example.com"}, {"op": "view", "kind": "outline"}, {"op": "view", "kind": "links"}, {"op": "find_text", "text": "Learn"}, {"op": "status"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 4, "min_len": 1}, {"on": 5, "path": "ok", "eq": true}], "tags": []}
{"id": 111, "complexity": 8, "english": "Save the current session after loading example.com and confirm save ok with html_bytes.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "session_save", "name": "suite-save-demo"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "action", "eq": "session_save"}, {"on": -1, "path": "html_bytes", "gte": 100}], "tags": ["session"]}
{"id": 112, "complexity": 8, "english": "List saved sessions and get a non-negative count.", "ops": [{"op": "session_list"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "count", "gte": 0}], "tags": ["session"]}
{"id": 113, "complexity": 9, "english": "Save then shim the same session back and confirm current url is example.com.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "session_save", "name": "suite-shim-demo"}, {"op": "session_load", "name": "suite-shim-demo"}, {"op": "current"}], "assert": [{"on": 2, "path": "ok", "eq": true}, {"on": 2, "path": "action", "eq": "session_shim"}, {"on": 2, "path": "shim_from", "exists": true}, {"on": 3, "path": "url", "contains": "example.com"}], "tags": ["session"]}
{"id": 114, "complexity": 9, "english": "session_load without id fails with bad_args.", "ops": [{"op": "session_load"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": ["session"]}
{"id": 115, "complexity": 8, "english": "Hancock request without wait queues a permission and never claims APPROVED_AND_RAN by default.", "ops": [{"op": "hancock_request", "action": "navigate", "why": "suite probe", "risk": "high", "wait": false, "detail": {"url": "https://example.com"}}], "assert": [{"on": -1, "path": "action", "eq": "hancock_request"}, {"on": -1, "path": "outcome", "ne": "APPROVED_AND_RAN"}], "tags": ["hancock"]}
{"id": 116, "complexity": 8, "english": "Hancock pending list returns a structured response with english.", "ops": [{"op": "hancock_pending"}], "assert": [{"on": -1, "path": "action", "eq": "hancock_pending"}, {"on": -1, "path": "english", "type": "string"}], "tags": ["hancock"]}
{"id": 117, "complexity": 9, "english": "Hancock wait without id fails bad_args.", "ops": [{"op": "hancock_wait"}], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": ["hancock"]}
{"id": 118, "complexity": 1, "english": "Send a non-JSON line to the API and expect a bad_json error response.", "raw_ops": ["this is not json {{{"], "assert": [{"on": -1, "path": "ok", "eq": false}], "tags": ["raw"]}
{"id": 119, "complexity": 4, "english": "Ask the engine to settle and confirm it returns a receipt saying it is quiescent, not a guess.", "ops": [{"op": "navigate", "url": "https://example.com"}, {"op": "settle"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "quiescent", "eq": true}, {"on": -1, "path": "engine", "exists": true}, {"on": -1, "path": "spins", "type": "number"}], "tags": ["settle"]}
{"id": 120, "complexity": 5, "english": "The static engine loading the JS fixture sees only the pre-JS shell — no POST-JS-MARKER — which is what makes the servo cases meaningful.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "read"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 0, "path": "title", "eq": "pre-js shell"}, {"on": -1, "path": "text", "not_contains": "POST-JS-MARKER"}], "tags": ["static-only", "fixture"]}
{"id": 121, "complexity": 3, "english": "With the servo engine selected, ping reports that servo is the engine actually answering.", "ops": [{"op": "ping"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "engine", "eq": "servo"}], "tags": ["servo"]}
{"id": 122, "complexity": 6, "english": "Servo navigates the JS fixture and reports the title JavaScript set at runtime, not the pre-JS one.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "title", "eq": "post-js title"}], "tags": ["servo", "faithful-js", "fixture"]}
{"id": 123, "complexity": 6, "english": "Servo's snapshot contains a heading that only exists after the page's JavaScript ran.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "find_text", "text": "POST-JS-MARKER"}], "assert": [{"on": -1, "type": "list"}, {"on": -1, "path": "0.text", "contains": "POST-JS-MARKER"}], "tags": ["servo", "faithful-js", "fixture"]}
{"id": 124, "complexity": 6, "english": "Reading the page text under servo returns copy written by JavaScript at runtime.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "read"}], "assert": [{"on": -1, "path": "text", "contains": "rendered by javascript"}], "tags": ["servo", "faithful-js", "fixture"]}
{"id": 125, "complexity": 6, "english": "Servo's settle receipt reports quiescence reached and how many event-loop turns it took.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "settle"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "engine", "eq": "servo"}, {"on": -1, "path": "quiescent", "eq": true}, {"on": -1, "path": "spins", "type": "number"}, {"on": -1, "path": "reason", "ne": "cap"}], "tags": ["servo", "settle", "fixture"]}
{"id": 126, "complexity": 8, "english": "Clicking a button that JavaScript created runs the page's real click handler and new text appears.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "find_text", "text": "GROW"}, {"op": "click", "node_id": "$find0"}, {"op": "read"}], "assert": [{"on": -1, "path": "text", "contains": "CLICK-HANDLER-RAN"}], "tags": ["servo", "faithful-js", "fixture"]}
{"id": 127, "complexity": 7, "english": "A link that JavaScript appended after load is visible in the links view with its resolved href.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "links"}], "assert": [{"on": -1, "type": "list"}, {"on": -1, "path": "0.href", "contains": "post-js-link"}], "tags": ["servo", "faithful-js", "fixture"]}
{"id": 128, "complexity": 8, "english": "Log in on the fixture site, then fetch the protected page — servo carries the session cookie across the navigation and shows logged-in content.", "ops": [{"op": "navigate", "url": "{{HTTP}}/login"}, {"op": "navigate", "url": "{{HTTP}}/protected"}, {"op": "read"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 1, "path": "ok", "eq": true}, {"on": -1, "path": "text", "contains": "LOGGED IN AS AGENT"}, {"on": -1, "path": "text", "not_contains": "LOGIN WALL"}], "tags": ["servo", "auth-session", "http"]}
{"id": 129, "complexity": 7, "english": "Servo reports a non-empty single HTML buffer for the post-JS document, so views stay projections of one page.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "views"}], "assert": [{"on": -1, "path": "ok", "eq": true}, {"on": -1, "path": "html_bytes", "gte": 100}], "tags": ["servo", "fixture"]}
{"id": 130, "complexity": 9, "english": "Save a JS-rendered page under servo and shim it back — the shimmed page still shows the post-JS content and the original url.", "ops": [{"op": "navigate", "url": "{{FIXTURES}}/js-render.html"}, {"op": "session_save", "name": "suite-servo-shim"}, {"op": "session_load", "name": "suite-servo-shim"}, {"op": "read"}, {"op": "current"}], "assert": [{"on": 1, "path": "ok", "eq": true}, {"on": 2, "path": "ok", "eq": true}, {"on": 3, "path": "text", "contains": "POST-JS-MARKER"}, {"on": 4, "path": "url", "contains": "js-render.html"}], "tags": ["servo", "session", "fixture"]}
{"id": 131, "complexity": 8, "english": "Log in on the fixture site and shut the engine down cleanly so the cookie jar is written to the profile directory on disk.", "ops": [{"op": "navigate", "url": "{{HTTP}}/login"}, {"op": "status"}, {"op": "quit", "force": true}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": 1, "path": "profile_dir", "type": "string"}, {"on": 2, "path": "ok", "eq": true}, {"on": 2, "path": "action", "eq": "quit"}], "tags": ["servo", "auth-session", "http"]}
{"id": 132, "complexity": 9, "english": "A brand-new process that never logs in still sees the protected page — the session came off disk, not from memory.", "ops": [{"op": "navigate", "url": "{{HTTP}}/protected"}, {"op": "read"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": -1, "path": "text", "contains": "LOGGED IN AS AGENT"}, {"on": -1, "path": "text", "not_contains": "LOGIN WALL"}], "tags": ["servo", "auth-session", "http"]}
{"id": 133, "complexity": 9, "english": "Control: the same fetch with an empty profile directory hits the login wall — proving the previous case passed because of the saved jar, not because the fixture always says yes.", "ops": [{"op": "navigate", "url": "{{HTTP}}/protected"}, {"op": "read"}], "assert": [{"on": 0, "path": "ok", "eq": true}, {"on": -1, "path": "text", "contains": "LOGIN WALL"}, {"on": -1, "path": "text", "not_contains": "LOGGED IN AS AGENT"}], "tags": ["servo", "auth-session", "http"], "env": {"CHRIME_PROFILE_DIR": "{{EMPTY_PROFILE}}"}}

{"id": 134,"complexity": 1,"english": "Help lists the forward and query ops.","ops": [{"op": "help"}],"assert": [{"on": -1,"path": "ops","contains": "forward"},{"on": -1,"path": "ops","contains": "query"}],"tags": []}
{"id": 135,"complexity": 2,"english": "Forward with no history fails with no_forward.","ops": [{"op": "forward"}],"assert": [{"on": -1,"path": "ok","eq": false},{"on": -1,"path": "code","eq": "no_forward"}],"tags": []}
{"id": 136,"complexity": 7,"english": "Navigate A then B, back to A, forward returns to B.","ops": [{"op": "navigate","url": "https://example.com"},{"op": "navigate","url": "https://example.org"},{"op": "back"},{"op": "forward"}],"assert": [{"on": 2,"path": "ok","eq": true},{"on": 2,"path": "url","contains": "example.com"},{"on": 3,"path": "ok","eq": true},{"on": 3,"path": "url","contains": "example.org"}],"tags": ["network"]}
{"id": 137,"complexity": 6,"english": "After back, status reports a non-zero forward_len.","ops": [{"op": "navigate","url": "https://example.com"},{"op": "navigate","url": "https://example.org"},{"op": "back"},{"op": "status"}],"assert": [{"on": -1,"path": "ok","eq": true},{"on": -1,"path": "forward_len","gte": 1},{"on": -1,"path": "url","contains": "example.com"}],"tags": ["network"]}
{"id": 138,"complexity": 5,"english": "Query a[href] on example.com returns at least one link node.","ops": [{"op": "navigate","url": "https://example.com"},{"op": "query","selector": "a[href]"}],"assert": [{"on": -1,"path": "ok","eq": true},{"on": -1,"path": "count","gte": 1},{"on": -1,"path": "nodes.0.node_id","gte": 1}],"tags": []}
{"id": 139,"complexity": 4,"english": "Query with empty selector fails bad_args.","ops": [{"op": "query","selector": ""}],"assert": [{"on": -1,"path": "ok","eq": false},{"on": -1,"path": "code","eq": "bad_args"}],"tags": []}
{"id": 140,"complexity": 4,"english": "Query with an invalid CSS selector fails bad_selector.","ops": [{"op": "navigate","url": "https://example.com"},{"op": "query","selector": "a["}],"assert": [{"on": -1,"path": "ok","eq": false},{"on": -1,"path": "code","eq": "bad_selector"}],"tags": []}
{"id": 141,"complexity": 6,"english": "Query h1 on example.com finds the Example Domain heading.","ops": [{"op": "navigate","url": "https://example.com"},{"op": "query","selector": "h1"}],"assert": [{"on": -1,"path": "ok","eq": true},{"on": -1,"path": "count","gte": 1},{"on": -1,"path": "nodes.0.text","contains": "Example"}],"tags": []}
{"id": 142,"complexity": 1,"english": "Help lists the layout op for dual-pane geometry.","ops": [{"op": "help"}],"assert": [{"on": -1,"path": "ops","contains": "layout"}],"tags": []}
{"id": 143,"complexity": 3,"english": "Layout without a live GUI surface fails with no_live (headless has no panes).","ops": [{"op": "layout","mode": "side"}],"assert": [{"on": -1,"path": "ok","eq": false},{"on": -1,"path": "code","eq": "no_live"}],"tags": []}
